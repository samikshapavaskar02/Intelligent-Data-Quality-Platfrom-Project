# PostgreSQL server host (default: localhost).
DB_HOST=localhost

# PostgreSQL server port (default: 5432).
DB_PORT=5432

# Name of an already-created PostgreSQL database (default: intelligent_data_quality).
DB_NAME=intelligent_data_quality

# PostgreSQL role/user (default: postgres).
DB_USER=postgres

# Required. Replace this placeholder with your local PostgreSQL password.
DB_PASSWORD=replace_with_your_local_password
